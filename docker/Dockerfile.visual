FROM homeagent-ros2:humble

# Gazebo Classic native 3D client, isolated browser-accessible X server.
# noVNC only sees this virtual desktop, never the Tang host desktop.
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      xvfb x11vnc novnc websockify fluxbox x11-utils \
      mesa-utils fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
