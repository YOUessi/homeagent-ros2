<?xml version="1.0"?>
<sdf version="1.6">
  <world name="home_room">
    <gravity>0 0 -9.81</gravity>
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="north_wall">
      <static>true</static>
      <pose>0 3 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.12 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6 0.12 1.5</size></box></geometry></visual>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <pose>0 -3 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.12 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6 0.12 1.5</size></box></geometry></visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>3 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 6 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 6 1.5</size></box></geometry></visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-3 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 6 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 6 1.5</size></box></geometry></visual>
      </link>
    </model>

    <model name="sofa_block">
      <static>true</static>
      <pose>-1.45 1.0 0.32 0 0 0.2</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5 0.65 0.64</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.5 0.65 0.64</size></box></geometry></visual>
      </link>
    </model>

    <model name="table_block">
      <static>true</static>
      <pose>1.25 0.9 0.38 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 0.7 0.76</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 0.7 0.76</size></box></geometry></visual>
      </link>
    </model>

    <model name="cabinet_block">
      <static>true</static>
      <pose>1.9 -1.65 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.7 0.45 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 0.45 1.2</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
