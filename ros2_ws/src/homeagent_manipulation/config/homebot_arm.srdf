<?xml version="1.0"?>
<robot name="homebot_arm">
  <group name="arm">
    <chain base_link="arm_base_link" tip_link="tool_link"/>
  </group>

  <group name="gripper">
    <joint name="gripper_joint"/>
  </group>

  <group_state name="open" group="gripper">
    <joint name="gripper_joint" value="0.04"/>
  </group_state>

  <group_state name="closed" group="gripper">
    <joint name="gripper_joint" value="0.0"/>
  </group_state>

  <group_state name="home" group="arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="0.0"/>
    <joint name="joint3" value="0.0"/>
    <joint name="joint4" value="0.0"/>
  </group_state>

  <group_state name="inspect" group="arm">
    <joint name="joint1" value="0.35"/>
    <joint name="joint2" value="-0.55"/>
    <joint name="joint3" value="1.05"/>
    <joint name="joint4" value="-0.50"/>
  </group_state>

  <passive_joint name="left_wheel_joint"/>
  <passive_joint name="right_wheel_joint"/>

  <disable_collisions link1="arm_base_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_link" link2="tool_link" reason="Adjacent"/>
  <disable_collisions link1="tool_link" link2="gripper_fixed_finger_link" reason="Adjacent"/>
  <disable_collisions link1="tool_link" link2="gripper_finger_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_fixed_finger_link" link2="gripper_finger_link" reason="Never"/>
</robot>
