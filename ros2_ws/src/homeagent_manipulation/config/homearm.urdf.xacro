<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="homearm">
  <material name="gray"><color rgba="0.35 0.38 0.42 1"/></material>
  <material name="blue"><color rgba="0.12 0.35 0.75 1"/></material>
  <material name="orange"><color rgba="0.9 0.45 0.08 1"/></material>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.04"/>
      <geometry><cylinder radius="0.11" length="0.08"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04"/>
      <geometry><cylinder radius="0.11" length="0.08"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04"/>
      <mass value="2.0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0.14"/>
      <geometry><box size="0.07 0.07 0.28"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.14"/>
      <geometry><box size="0.06 0.06 0.28"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.14"/>
      <mass value="1.0"/>
      <inertia ixx="0.008" iyy="0.008" izz="0.003" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.8" upper="2.8" effort="40" velocity="1.5"/>
  </joint>

  <link name="upper_arm_link">
    <visual>
      <origin xyz="0.14 0 0"/>
      <geometry><box size="0.28 0.06 0.06"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.14 0 0"/>
      <geometry><box size="0.28 0.05 0.05"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.14 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.002" iyy="0.007" izz="0.007" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.28" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.8" upper="1.8" effort="30" velocity="1.3"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <origin xyz="0.12 0 0"/>
      <geometry><box size="0.24 0.055 0.055"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.12 0 0"/>
      <geometry><box size="0.24 0.045 0.045"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.12 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.0015" iyy="0.004" izz="0.004" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0.28 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2" effort="25" velocity="1.5"/>
  </joint>

  <link name="wrist_link">
    <visual>
      <origin xyz="0.08 0 0"/>
      <geometry><box size="0.16 0.05 0.05"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0.08 0 0"/>
      <geometry><box size="0.16 0.04 0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.08 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.001" iyy="0.0025" izz="0.0025" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="joint4" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0.24 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.8" upper="2.8" effort="15" velocity="2.0"/>
  </joint>

  <link name="tool_link">
    <visual>
      <origin xyz="0.035 0 0"/>
      <geometry><box size="0.07 0.07 0.025"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.035 0 0"/>
      <geometry><box size="0.07 0.06 0.02"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.035 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0002" iyy="0.0002" izz="0.0002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="tool_joint" type="fixed">
    <parent link="wrist_link"/>
    <child link="tool_link"/>
    <origin xyz="0.16 0 0"/>
  </joint>

  <link name="gripper_fixed_finger_link">
    <visual>
      <origin xyz="0.05 0 0"/>
      <geometry><box size="0.10 0.012 0.03"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0.05 0 0"/>
      <geometry><box size="0.10 0.012 0.03"/></geometry>
    </collision>
  </link>

  <joint name="gripper_fixed_finger_joint" type="fixed">
    <parent link="tool_link"/>
    <child link="gripper_fixed_finger_link"/>
    <origin xyz="0.07 -0.025 0"/>
  </joint>

  <link name="gripper_finger_link">
    <visual>
      <origin xyz="0.05 0 0"/>
      <geometry><box size="0.10 0.012 0.03"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0.05 0 0"/>
      <geometry><box size="0.10 0.012 0.03"/></geometry>
    </collision>
  </link>

  <joint name="gripper_joint" type="prismatic">
    <parent link="tool_link"/>
    <child link="gripper_finger_link"/>
    <origin xyz="0.07 0.025 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.04" effort="20" velocity="0.08"/>
  </joint>

  <ros2_control name="HomeArmSystem" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="calculate_dynamics">false</param>
    </hardware>

    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint3">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint4">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="gripper_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.04</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
